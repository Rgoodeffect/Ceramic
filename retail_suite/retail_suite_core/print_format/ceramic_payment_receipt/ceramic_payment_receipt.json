{
 "align_labels_right": 0,
 "creation": "2026-07-30 00:00:00.000000",
 "css": ".retail-print{font-family:'Helvetica Neue',Arial,sans-serif;color:#1f2937;font-size:12px}.retail-print .header{border-bottom:2px solid #1f2937;padding-bottom:12px;margin-bottom:16px}.retail-print .doc-title{font-size:20px;font-weight:700;margin:0}.retail-print .muted{color:#6b7280;font-size:11px}.retail-print .totals{width:320px;margin-top:12px}.retail-print .totals div{display:flex;justify-content:space-between;padding:4px 0;font-size:13px;border-bottom:1px solid #e5e7eb}.retail-print .totals .grand{font-weight:700;font-size:16px;border-top:1px solid #1f2937;border-bottom:none;margin-top:4px;padding-top:8px}",
 "disabled": 0,
 "doc_type": "Payment Entry",
 "doctype": "Print Format",
 "font": "Default",
 "html": "<div class=\"retail-print\">\n  <div class=\"header\">\n    <p class=\"doc-title\">Payment Receipt</p>\n    <p class=\"muted\">Receipt No. {{ doc.name }} &middot; {{ doc.get_formatted(\"posting_date\") }}</p>\n  </div>\n\n  <div class=\"totals\">\n    <div><span>Customer</span><span>{{ doc.party_name if doc.party_type == \"Customer\" else doc.party }}</span></div>\n    <div><span>Payment Method</span><span>{{ doc.mode_of_payment or doc.payment_type }}</span></div>\n    <div><span>Received By</span><span>{{ frappe.db.get_value(\"User\", doc.owner, \"full_name\") or doc.owner }}</span></div>\n    <div class=\"grand\"><span>Amount</span><span>{{ frappe.utils.fmt_money(doc.paid_amount, currency=doc.paid_to_account_currency or doc.currency) }}</span></div>\n  </div>\n\n  {% if doc.custom_qr_code %}\n  <div style=\"margin-top:16px\">{{ doc.get_formatted(\"custom_qr_code\") }}</div>\n  {% endif %}\n</div>\n",
 "line_breaks": 0,
